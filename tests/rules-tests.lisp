(in-package :stonehue/tests)

(in-suite stonehue-suite)

(test capture-single-stone
  (let ((pos (make-position 9)))
    (is-true (play-at pos +black+ "E5"))
    (is-true (play-at pos +white+ "D5"))
    (is-true (play-at pos +black+ "A1"))
    (is-true (play-at pos +white+ "E4"))
    (is-true (play-at pos +black+ "A2"))
    (is-true (play-at pos +white+ "F5"))
    (is-true (play-at pos +black+ "A3"))
    (is-true (play-at pos +white+ "E6"))
    (is (= +empty+ (stone-at pos (index pos "E5"))))
    (is (= 1 (position-captured-last pos)))))

(test capture-group
  (let ((pos (make-position 9)))
    (is-true (play-at pos +black+ "E5"))
    (is-true (play-at pos +white+ "D5"))
    (is-true (play-at pos +black+ "F5"))
    (is-true (play-at pos +white+ "E4"))
    (is-true (play-at pos +black+ "A1"))
    (is-true (play-at pos +white+ "E6"))
    (is-true (play-at pos +black+ "A2"))
    (is-true (play-at pos +white+ "G5"))
    (is-true (play-at pos +black+ "A3"))
    (is-true (play-at pos +white+ "F4"))
    (is-true (play-at pos +black+ "A4"))
    (is-true (play-at pos +white+ "F6"))
    (is (= +empty+ (stone-at pos (index pos "E5"))))
    (is (= +empty+ (stone-at pos (index pos "F5"))))
    (is (= 2 (position-captured-last pos)))))

(test suicide-illegal
  (let ((pos (make-position 9)))
    (play-at pos +black+ "E4")
    (play-at pos +white+ "A1")
    (play-at pos +black+ "E6")
    (play-at pos +white+ "A2")
    (play-at pos +black+ "D5")
    (play-at pos +white+ "A3")
    (play-at pos +black+ "F5")
    (play-at pos +white+ "A4")
    (setf (position-to-play pos) +white+)
    (is-false (try-play pos +white+ (index pos "E5")))))

(test self-atari-with-capture-is-legal
  (let ((pos (make-position 9)))
    (play-at pos +black+ "E5")
    (play-at pos +white+ "D5")
    (play-at pos +black+ "D6")
    (play-at pos +white+ "E4")
    (play-at pos +black+ "F6")
    (play-at pos +white+ "F5")
    (play-at pos +black+ "E7")
    (play-at pos +white+ "A1")
    (is-true (play-at pos +white+ "E6"))
    (is (= +empty+ (stone-at pos (index pos "E5"))))
    (is (= 1 (position-captured-last pos)))))

(test simple-ko-prohibits-immediate-recapture
  (let ((pos (make-position 9)))
    (play-at pos +black+ "A2")
    (play-at pos +white+ "B2")
    (play-at pos +black+ "B1")
    (play-at pos +white+ "A3")
    (play-at pos +black+ "C2")
    (play-at pos +white+ "C3")
    (play-at pos +black+ "G1")
    (play-at pos +white+ "B4")
    (is-true (play-at pos +black+ "B3"))
    (is (= +empty+ (stone-at pos (index pos "B2"))))
    (is (= 1 (position-captured-last pos)))
    (setf (position-to-play pos) +white+)
    (is-false (try-play pos +white+ (index pos "B2")))
    (is-true (play-at pos +white+ "G2"))
    (is-true (play-at pos +black+ "H1"))
    (is-true (play-at pos +white+ "B2"))
    (is (= +white+ (stone-at pos (index pos "B2"))))
    (is (= +empty+ (stone-at pos (index pos "B3"))))))

(test wrong-turn-rejected
  (let ((pos (make-position 9)))
    (is-false (try-play pos +white+ (index pos "D4")))
    (is-true (try-play pos +black+ (index pos "D4")))
    (is-false (try-play pos +black+ (index pos "D5")))))

(test pass-and-terminal
  (let ((pos (make-position 9)))
    (is (not (is-terminal-p pos)))
    (pass-move pos +black+)
    (is (not (is-terminal-p pos)))
    (pass-move pos +white+)
    (is (is-terminal-p pos))))

(test legal-moves-exclude-illegal
  (let ((pos (make-position 9)))
    (play-at pos +black+ "E4")
    (play-at pos +white+ "A1")
    (play-at pos +black+ "E6")
    (play-at pos +white+ "A2")
    (play-at pos +black+ "D5")
    (play-at pos +white+ "A3")
    (play-at pos +black+ "F5")
    (play-at pos +white+ "A4")
    (setf (position-to-play pos) +white+)
    (is (not (member (index pos "E5") (legal-moves pos))))
    (is (member (index pos "G5") (legal-moves pos)))))

(test legal-moves-includes-atari-point
  (let ((pos (make-position 9)))
    (play-at pos +black+ "D5")
    (play-at pos +white+ "A1")
    (play-at pos +black+ "E4")
    (play-at pos +white+ "A2")
    (play-at pos +black+ "F5")
    (play-at pos +white+ "A3")
    (setf (position-to-play pos) +black+)
    (is (member (index pos "E5") (legal-moves pos)))))

(test position-copy-is-independent
  (let ((pos (make-position 9)))
    (try-play pos +black+ (index pos "D4"))
    (let ((copy (position-copy pos)))
      (try-play copy +white+ (index copy "D6"))
      (is (= +black+ (stone-at pos (index pos "D4"))))
      (is (= +white+ (stone-at copy (index copy "D6"))))
      (is (= +white+ (position-to-play pos)))
      (is (= +black+ (position-to-play copy))))))

(test group-of-and-liberties
  (let ((pos (make-position 9)))
    (play-at pos +black+ "D4")
    (play-at pos +white+ "D5")
    (play-at pos +black+ "E4")
    (play-at pos +white+ "E5")
    (let* ((group (group-of pos (index pos "D4")))
           (libs (group-liberties pos group)))
      (is (= 2 (length group)))
      (is (member (index pos "C4") libs))
      (is (member (index pos "F4") libs))
      (is (member (index pos "D3") libs))
      (is (member (index pos "E3") libs))
      (is (not (member (index pos "D5") libs)))
      (is (not (member (index pos "E5") libs)))
      (is (= 4 (length libs))))))
